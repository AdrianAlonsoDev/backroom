{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": true,
	"sortImports": {
		"groups": [
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		]
	},
	"sortPackageJson": true,
	"overrides": [
		{
			"files": ["**/*.json", "**/*.jsonc"],
			"options": { "trailingComma": "none" }
		}
	]
}
