# Where the early access form sends its JSON ({ email, intent, locale }).
# For example a Formspree form: https://formspree.io/f/your-form-id
# Leave it empty while you try the page: the form then sends nothing.
NEXT_PUBLIC_SIGNUP_ENDPOINT=

# The public URL of the site, used for metadata and the social image.
NEXT_PUBLIC_SITE_URL=
